# AI-IaC Guard — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit your real .env file.

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration (backend only — never exposed to client)
# ─────────────────────────────────────────────────────────────────────────────

# Provider choices: gemini | openai | anthropic | ollama | mock
LLM_PROVIDER=gemini

# Your API Key (required for gemini, openai, anthropic)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=AIzaSy...your_gemini_api_key_here

# Optional: Override the default model
# gemini defaults:    gemini-2.5-flash (or gemini-2.0-flash, gemini-1.5-pro)
# openai defaults:    gpt-4o-mini (or gpt-4o)
# anthropic defaults: claude-3-5-haiku-20241022 (or claude-3-5-sonnet-20241022)
# ollama defaults:    llama3.2
LLM_MODEL=gemini-2.5-flash

# Optional: Custom base URL (only needed for local Ollama or custom proxies)
# ollama example: http://localhost:11434
LLM_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Backend Settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
